# CareCompass Backend Environment Variables
# Copy this to .env and fill in your credentials

# Interhuman AI
INTERHUMAN_API_KEY=your_interhuman_api_key_here

# Plaud Embedded (from https://portal.plaud.ai)
# CLIENT_ID: Identifies your application
PLAUD_CLIENT_ID=your_plaud_client_id_here
# SECRET_KEY: Used to mint partner tokens (for generating user tokens)
PLAUD_SECRET_KEY=your_plaud_secret_key_here
# API_KEY: Used for Transcription API calls
PLAUD_API_KEY=your_plaud_api_key_here

# Crusoe Inference API
CRUSOE_API_KEY=your_crusoe_api_key_here

# Neo4j Aura (Knowledge Graph) - optional, for tracking provider improvement
# Get a free instance at https://console.neo4j.io
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
